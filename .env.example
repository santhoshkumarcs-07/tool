# ── OpenRouter Configuration (Exclusive Free LLM Gateway) ───────
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# ── Application & Security Settings ──────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-secure-random-secret
FLASK_DEBUG=false
ENABLE_HTTPS=false
HOST=0.0.0.0
PORT=5000

# ── Production WSGI (Gunicorn) Settings ──────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
LOG_LEVEL=info

# ── Processing & Upload Limits ───────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=1200

# ── Persistent Storage Directory ─────────────────────────────────
DATA_DIR=data
